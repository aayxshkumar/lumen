print(7.0 / 2);      // expect: 3.5
print(1 + 2.0);      // expect: 3.0
print(0.1 + 0.2);    // expect: 0.30000000000000004
print(1e3);          // expect: 1000.0
print(2.5e-3);       // expect: 0.0025
print(1.0 / 0);      // expect: inf
print(-1.0 / 0);     // expect: -inf
print(7.5 % 2);      // expect: 1.5
print(int(3.99), int(-3.99));  // expect: 3 -3
print(float(2));     // expect: 2.0
print(sqrt(16));     // expect: 4.0
