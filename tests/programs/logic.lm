print(true and false, true or false, not true);  // expect: false true false
// Short-circuit: the right side is not evaluated.
let hits = [];
fn touch(v) { push(hits, v); return v; }
print(false and touch(true));  // expect: false
print(true or touch(false));   // expect: true
print(len(hits));              // expect: 0
print(true and touch(true), len(hits));  // expect: true 1
