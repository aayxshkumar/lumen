let text = "the cat and the hat and the bat";
let counts = {};
for w in split(text, " ") {
  if has(counts, w) { counts[w] = counts[w] + 1; } else { counts[w] = 1; }
}
print(counts);         // expect: {"the": 3, "cat": 1, "and": 2, "hat": 1, "bat": 1}
let ws = keys(counts);
sort(ws, fn(a, b) { if counts[a] != counts[b] { return counts[a] > counts[b]; } return a < b; });
print(ws);             // expect: ["the", "and", "bat", "cat", "hat"]
