// Float arithmetic: a two-body orbit with a fixed time step.
let x = 1.0; let y = 0.0; let vx = 0.0; let vy = 1.0;
let dt = 0.0001;
for step in range(200000) {
  let r2 = x * x + y * y;
  let r3 = r2 * sqrt(r2);
  vx = vx - x / r3 * dt;
  vy = vy - y / r3 * dt;
  x = x + vx * dt;
  y = y + vy * dt;
}
print(int(x * 1000000), int(y * 1000000));
